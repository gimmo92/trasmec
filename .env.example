# Copia questo file in ".env.local" e inserisci la tua API key di Claude
ANTHROPIC_API_KEY=sk-ant-...

# Modello Claude da usare (default: claude-opus-5)
ANTHROPIC_MODEL=claude-opus-5-5

# Cartella dei documenti di input (distinte base, template, listini)
DOCUMENTI_DIR=./documenti

# Supabase (le stesse variabili vanno su Vercel). Senza queste, l'app usa i file locali.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...

# Firma dei cookie di accesso. Se manca, in produzione si usa SUPABASE_SERVICE_ROLE_KEY.
AUTH_SECRET=una-stringa-lunga-e-casuale
